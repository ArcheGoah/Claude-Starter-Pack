# =====================================================
# .env.example - Kopiere zu .env und fuelle deine Keys
# .env darf NIEMALS in Git committed werden (siehe .gitignore)
# =====================================================

# --- Claude Code / Anthropic ---
# Falls du Claude API direkt nutzt
ANTHROPIC_API_KEY=

# --- Notion (optional) ---
# https://www.notion.so/profile/integrations -> Create new integration
NOTION_TOKEN=

# --- Firecrawl (optional, fuer Web-Scraping) ---
# https://firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=

# --- OpenAI (optional, fuer codex-review Skill) ---
OPENAI_API_KEY=

# --- Groq (optional, fuer schnelle LLM Calls) ---
GROQ_API_KEY=

# --- Discord Bot (optional) ---
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=

# --- Instagram (fuer instaloader / insta-analytics) ---
# Tipp: Nutze einen Zweit-Account oder Test-Account
IG_USERNAME=
IG_PASSWORD=
# Alternative: Session-Cookies in config/cookies.txt

# --- Vercel (optional) ---
VERCEL_TOKEN=

# --- Sketchfab (optional, fuer Blender MCP 3D Downloads) ---
SKETCHFAB_API_TOKEN=

# --- Gemini API (optional, fuer gemini-video-analyzer) ---
GOOGLE_AI_API_KEY=

# --- ElevenLabs (optional, fuer TTS) ---
ELEVENLABS_API_KEY=

# --- Sentry (optional, fuer Error Tracking) ---
SENTRY_DSN=
